# Protected multi-stage build for PPL Meta Mini
# Compiles proprietary modules to .so and strips matching .py from the runtime image.
# FastAPI shell (main.py, api/) remains plain Python — same model as ppl-meta-vmeta.
ARG BASE_IMAGE=python:3.11-slim
ARG PPL_VERSION=2.19.19

FROM ${BASE_IMAGE} AS builder

ARG PPL_VERSION=2.19.19

LABEL version="${PPL_VERSION}" \
      description="PPL Meta Mini v${PPL_VERSION} - Protected builder" \
      maintainer="Nick Glezakos <nick@pplmeta.com>"

RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libopenblas-dev \
    liblapack-dev \
    libx11-dev \
    libgtk-3-dev \
    python3-dev \
    wget \
    curl \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY setup_cmake.sh /tmp/setup_cmake.sh
RUN chmod +x /tmp/setup_cmake.sh && \
    /tmp/setup_cmake.sh && \
    rm /tmp/setup_cmake.sh

RUN cmake --version

WORKDIR /app

COPY requirements.tensorflow.txt .
RUN pip install --no-cache-dir -r requirements.tensorflow.txt

COPY src/ ./src/
COPY setup_protected.py .

# package_dir src + --inplace writes *.so next to the original .py under src/
RUN python setup_protected.py build_ext --inplace \
 && python setup_protected.py verify

FROM ${BASE_IMAGE} AS runtime

ARG PPL_VERSION=2.19.19

LABEL version="${PPL_VERSION}" \
      description="PPL Meta Mini v${PPL_VERSION} - Protected runtime (no proprietary .py)"

RUN apt-get update && apt-get install -y \
    libopencv-dev \
    python3-opencv \
    libglib2.0-0 \
    libgomp1 \
    libopenblas-dev \
    liblapack-dev \
    libblas-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.runtime.txt .
RUN pip install --no-cache-dir -r requirements.runtime.txt

# Native deps (dlib, TensorFlow, DeepFace) from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages

COPY --from=builder /app/src/ ./src/
COPY --from=builder /app/setup_protected.py ./setup_protected.py

ENV PYTHONPATH=/app/src

# Verify .so, strip proprietary .py, smoke-import from extensions, then drop helper
RUN python setup_protected.py verify \
 && find /app/src -name "*.pyc" -delete \
 && find /app/src -name "*.c" -delete \
 && python setup_protected.py strip \
 && python setup_protected.py smoke \
 && PYTHONPATH=/app/src python -c "from main import app; print('Runtime: FastAPI app imported (protected)')" \
 && rm -f /app/setup_protected.py

RUN mkdir -p uploads

EXPOSE 8004

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8004/health || exit 1

CMD ["python", "src/main.py"]
