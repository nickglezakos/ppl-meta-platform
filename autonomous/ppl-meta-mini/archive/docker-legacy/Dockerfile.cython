# Multi-stage build for Cython compilation
FROM python:3.11-slim AS builder

# Install system dependencies for compilation
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    gcc \
    g++ \
    libopencv-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgcc-s1 \
    pkg-config \
    python3-dev \
    libopenblas-dev \
    liblapack-dev \
    libx11-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy requirements and install Python dependencies including Cython
COPY requirements.cython.txt .
RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir -r requirements.cython.txt

# Copy source code
COPY src/ ./src/
COPY setup_cython.py .

# Compile with Cython (hybrid approach - only core modules)
RUN python setup_cython.py build_ext --inplace
RUN python setup_cython.py bdist_wheel

# Verify the build succeeded
RUN ls -la dist/ && echo "Cython compilation completed successfully"

# Runtime stage - minimal image with Python
FROM python:3.11-slim

# Install only runtime dependencies
RUN apt-get update && apt-get install -y \
    libopencv-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    libgcc-s1 \
    libopenblas0 \
    liblapack3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app directory and user
WORKDIR /app
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app

# Copy the compiled wheel and install it
COPY --from=builder /build/dist/*.whl ./
RUN pip install --no-cache-dir *.whl && rm *.whl

# Copy the original Python files (FastAPI components)
COPY --from=builder /build/src/main.py ./src/
COPY --from=builder /build/src/api/ ./src/api/

# Copy compiled extensions and other source files
COPY --from=builder /build/src/ ./src/

# Create directories for temporary files
RUN mkdir -p /app/temp /app/storage && chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8004

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8004/health || exit 1

# Set environment variables
ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1

# Run the application
CMD ["python", "-m", "uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8004"]
