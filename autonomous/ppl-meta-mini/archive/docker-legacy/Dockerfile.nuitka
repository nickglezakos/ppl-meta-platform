# Multi-stage build for Nuitka compilation
FROM python:3.11-slim as builder

# Install system dependencies for compilation
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libopencv-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy requirements and install Python dependencies
COPY requirements-nuitka.txt .
RUN pip install --no-cache-dir -r requirements-nuitka.txt

# Copy source code
COPY src/ ./src/
COPY build_nuitka.py .

# Build with Nuitka
RUN python build_nuitka.py

# Runtime stage - minimal image
FROM ubuntu:22.04

# Install only runtime dependencies
RUN apt-get update && apt-get install -y \
    libopencv-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy only the compiled executable and its dependencies
COPY --from=builder /build/dist/ppl-meta-mini.dist/ ./

# Create directories for temporary files
RUN mkdir -p /app/temp /app/storage

# Expose port
EXPOSE 8004

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8004/health || exit 1

# Run the compiled executable
CMD ["./ppl-meta-mini"]