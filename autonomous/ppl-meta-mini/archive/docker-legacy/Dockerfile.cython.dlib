# Multi-stage build for PPL Meta Mini with Cython and dlib support
# Stage 1: Build environment with all dependencies including CMake and dlib
FROM python:3.11-slim as builder

# Install system dependencies for building
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libopencv-dev \
    python3-opencv \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install CMake 3.24.3 binary for ARM64
RUN if [ "$(uname -m)" = "aarch64" ]; then \
    curl -L https://github.com/Kitware/CMake/releases/download/v3.24.3/cmake-3.24.3-linux-aarch64.tar.gz | tar -xz -C /opt && \
    ln -s /opt/cmake-3.24.3-linux-aarch64/bin/cmake /usr/local/bin/cmake; \
    else \
    curl -L https://github.com/Kitware/CMake/releases/download/v3.24.3/cmake-3.24.3-linux-x86_64.tar.gz | tar -xz -C /opt && \
    ln -s /opt/cmake-3.24.3-linux-x86_64/bin/cmake /usr/local/bin/cmake; \
    fi

# Verify CMake installation
RUN cmake --version

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies including dlib
COPY requirements.cython.dlib.txt .
RUN pip install --no-cache-dir -r requirements.cython.dlib.txt

# Copy source code
COPY src/ ./src/
COPY setup_cython_dlib.py .

# Build Cython extensions with dlib support
RUN python setup_cython_dlib.py build_ext --inplace

# Create distribution directory for pre-built modules
RUN mkdir -p /app/dist && \
    cp -r src/ /app/dist/ && \
    find /app/dist -name "*.so" -exec ls -la {} \; && \
    python -c "import dlib; print(f'dlib imported successfully: {dlib}')"# Stage 2: Runtime environment with minimal dependencies
FROM python:3.11-slim as runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libopencv-dev \
    python3-opencv \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy only runtime requirements
COPY requirements.runtime.txt .

# Install minimal runtime dependencies
RUN pip install --no-cache-dir -r requirements.runtime.txt

# Copy pre-built application from builder stage
COPY --from=builder /app/dist/src ./src
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages

# Verify dlib is available in runtime
RUN python -c "import dlib; print('Runtime: dlib successfully imported'); print(f'dlib module: {dlib}')"# Create uploads directory
RUN mkdir -p uploads

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Expose port
EXPOSE 8004

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8004/health || exit 1

# Run the application
CMD ["python", "src/main.py"]
