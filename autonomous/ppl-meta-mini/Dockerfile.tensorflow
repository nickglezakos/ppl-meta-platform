# Multi-stage Docker build for PPL Meta Mini with TensorFlow
# Supports both Debian Bookworm and Bullseye with guaranteed dlib compilation
# Build arguments for platform compatibility
ARG BASE_IMAGE=python:3.11-slim
ARG PPL_VERSION=2.19.19

# Stage 1: Builder with dlib compilation
FROM ${BASE_IMAGE} AS builder

# Import build arguments into the stage
ARG PPL_VERSION=2.19.19

# Metadata
LABEL version="${PPL_VERSION}" \
      description="PPL Meta Mini v${PPL_VERSION} - Autonomous Face Analytics Service" \
      maintainer="Nick Glezakos <nick@pplmeta.com>"

# Install system dependencies for building
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libopenblas-dev \
    liblapack-dev \
    libx11-dev \
    libgtk-3-dev \
    python3-dev \
    wget \
    curl \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy and execute universal CMake installation script
COPY setup_cmake.sh /tmp/setup_cmake.sh
RUN chmod +x /tmp/setup_cmake.sh && \
    /tmp/setup_cmake.sh && \
    rm /tmp/setup_cmake.sh

# Verify cmake installation and dlib compilation readiness
RUN cmake --version && \
    echo "✅ CMake installation verified" && \
    echo "✅ Build environment ready for dlib compilation"

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies including dlib
COPY requirements.tensorflow.txt .
RUN pip install --no-cache-dir -r requirements.tensorflow.txt

# Copy source code
COPY src/ ./src/
COPY setup_cython_dlib.py .

# Build Cython extensions
RUN python setup_cython_dlib.py build_ext --inplace

# Create distribution directory
RUN mkdir -p /app/dist && \
    cp -r src/ /app/dist/ && \
    find /app/dist -name "*.so" -exec echo "Built: {}" \;

# Stage 2: Runtime image
FROM ${BASE_IMAGE} AS runtime

# Import build arguments
ARG PPL_VERSION=2.19.19

# Runtime metadata
LABEL version="${PPL_VERSION}" \
      description="PPL Meta Mini v${PPL_VERSION} - Runtime Image"

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libopencv-dev \
    python3-opencv \
    libglib2.0-0 \
    libgomp1 \
    libopenblas-dev \
    liblapack-dev \
    libblas-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy runtime requirements
COPY requirements.runtime.txt .
RUN pip install --no-cache-dir -r requirements.runtime.txt

# Copy built application from builder stage
COPY --from=builder /app/dist/src ./src

# Copy Python packages from builder (including dlib, TensorFlow, DeepFace)
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages

# Set Python path to include /app for proper imports
ENV PYTHONPATH="/app:${PYTHONPATH}"

# Test installations
RUN python -c "import dlib; print('Runtime: dlib successfully imported'); print('dlib version:', dlib.__version__ if hasattr(dlib, '__version__') else '20.0.0')"
RUN python -c "import tensorflow as tf; print('Runtime: TensorFlow successfully imported'); print('TF version:', tf.__version__)"
RUN python -c "from deepface import DeepFace; print('Runtime: DeepFace successfully imported')"

# Test FastAPI application imports
RUN python -c "\
import sys; \
sys.path.insert(0, '/app/src'); \
from main import app; \
print('Runtime: FastAPI application imported successfully')"

# Create uploads directory
RUN mkdir -p uploads

# Set PYTHONPATH for proper imports
ENV PYTHONPATH=/app/src

# Expose port
EXPOSE 8004

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8004/health || exit 1

# Start the application
CMD ["python", "src/main.py"]
