# PPL Meta Media - Media Processing Service Environment Configuration

# Application Settings
APP_NAME=ppl-meta-media
APP_VERSION=1.0.2
DEBUG=false
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql://nickadmin:Kodikos%4023@localhost:5433/ppl_media_db
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ppl_media_db
DB_USER=nickadmin
DB_PASSWORD=Kodikos@23

# Security Settings
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production

# Media Processing Configuration
STORAGE_PATH=/tmp/ppl-meta-uploads
UPLOAD_DIR=/tmp/ppl-meta-uploads
MAX_FILE_SIZE=50MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,mp4,avi,mov

# Service Communication URLs
USER_SERVICE_URL=http://localhost:8001
GATEWAY_SERVICE_URL=http://localhost:8080
VISION_SERVICE_URL=

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Standardized Mail Configuration (for notifications)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=
MAIL_PORT=587
MAIL_FROM_NAME=PPL Meta Media
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
USE_CREDENTIALS=true
VALIDATE_CERTS=true
