# PPL Meta Media - Media Processing Service Environment Configuration
# WARNING: This file contains example values only. Do NOT commit actual secrets to version control!

# Application Settings
APP_NAME=ppl-meta-media
APP_VERSION=1.0.2
DEBUG=false
LOG_LEVEL=info
LOG_FORMAT=console
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Database Configuration
# Use secrets management for production: /run/secrets/database_password
DATABASE_URL=postgresql://nickadmin:${DATABASE_PASSWORD}@localhost:5433/ppl_media_db
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ppl_media_db
DB_USER=nickadmin
DB_PASSWORD=${DATABASE_PASSWORD}

# Security Settings - CHANGE THESE VALUES FOR PRODUCTION
# In production, these should be read from Docker secrets or external key management
SECRET_KEY=${SECRET_KEY}
JWT_SECRET=${JWT_SECRET}

# Media Processing Configuration
STORAGE_PATH=/tmp/ppl-meta-uploads
UPLOAD_DIR=/tmp/ppl-meta-uploads
MAX_FILE_SIZE=50MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,mp4,avi,mov

# Service Communication URLs
USER_SERVICE_URL=http://localhost:8001
GATEWAY_SERVICE_URL=http://localhost:8080
VISION_SERVICE_URL=${VISION_SERVICE_URL}

# Redis Configuration
# In production, use: /run/secrets/redis_password
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=${REDIS_PASSWORD}

# Standardized Mail Configuration (for notifications)
# In production, use: /run/secrets/mail_password
MAIL_USERNAME=${MAIL_USERNAME}
MAIL_PASSWORD=${MAIL_PASSWORD}
MAIL_FROM=${MAIL_FROM}
MAIL_SERVER=${MAIL_SERVER}
MAIL_PORT=587
MAIL_FROM_NAME=PPL Meta Media
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
USE_CREDENTIALS=true
VALIDATE_CERTS=true

# External Key Management
VAULT_TOKEN=${VAULT_TOKEN}
VAULT_URL=${VAULT_URL}

# Security Notes:
# 1. Replace ${VARIABLE} placeholders with actual values for development
# 2. Use secrets management (Docker secrets, Vault, etc.) for production
# 3. Never commit actual secrets to version control
# 4. Rotate secrets regularly using automated tools
# 5. Use strong, unique secrets for each environment
