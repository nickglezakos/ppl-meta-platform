# Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Application Information
APP_NAME=PPL Meta Gateway
APP_VERSION=1.0.0
APP_DESCRIPTION=PPL Meta Platform Gateway Service

# API Configuration
API_V1_PREFIX=/api/v1
SERVICE_NAME=ppl-meta-gateway
SERVICE_VERSION=1.0.0
HOST=0.0.0.0
PORT=8080

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration (Optional for Gateway)
DATABASE_URL=postgresql://nickadmin:Kodikos%4023@localhost:5433/ppl_gateway_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=gateway_db
DATABASE_USER=user
DATABASE_PASSWORD=password

# Service URLs
USER_SERVICE_URL=http://ppl-meta-node:8001
MEDIA_SERVICE_URL=http://ppl-meta-media:8000

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail Configuration (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=PPL Meta Platform
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
USE_CREDENTIALS=true
VALIDATE_CERTS=true

# File Storage
MEDIA_UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1

# Service Discovery
SERVICE_DISCOVERY_ENABLED=true
CONSUL_HOST=localhost
CONSUL_PORT=8500

# Nginx Configuration
NGINX_CONFIG_PATH=/etc/nginx/conf.d
NGINX_RELOAD_COMMAND=nginx -s reload

# Load Balancing
ENABLE_LOAD_BALANCING=true
HEALTH_CHECK_INTERVAL=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# Mesh VPN
MESH_VPN_ENABLED=false
MESH_VPN_INTERFACE=wg0

# External Services (Optional)
EXTERNAL_API_KEY=
EXTERNAL_API_URL=
