import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import '../../providers/automation_providers.dart';

/// Automation dashboard for monitoring and managing automation rules
/// Provides overview of active rules, execution history, and quick controls
class AutomationDashboard extends ConsumerStatefulWidget {
  const AutomationDashboard({Key? key}) : super(key: key);

  @override
  ConsumerState<AutomationDashboard> createState() => _AutomationDashboardState();
}

class _AutomationDashboardState extends ConsumerState<AutomationDashboard> 
    with TickerProviderStateMixin {
  late TabController _tabController;

  @override
  void initState() {
    super.initState();
    _tabController = TabController(length: 4, vsync: this);
  }

  @override
  void dispose() {
    _tabController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Automation Dashboard'),
        bottom: TabBar(
          controller: _tabController,
          tabs: const [
            Tab(icon: Icon(Icons.dashboard), text: 'Overview'),
            Tab(icon: Icon(Icons.rule), text: 'Rules'),
            Tab(icon: Icon(Icons.history), text: 'History'),
            Tab(icon: Icon(Icons.analytics), text: 'Analytics'),
          ],
        ),
        actions: [
          IconButton(
            onPressed: () => _showCreateRuleDialog(),
            icon: const Icon(Icons.add),
            tooltip: 'Create New Rule',
          ),
          IconButton(
            onPressed: () => _refreshData(),
            icon: const Icon(Icons.refresh),
            tooltip: 'Refresh',
          ),
        ],
      ),
      body: TabBarView(
        controller: _tabController,
        children: [
          _buildOverviewTab(),
          _buildRulesTab(),
          _buildHistoryTab(),
          _buildAnalyticsTab(),
        ],
      ),
      floatingActionButton: FloatingActionButton(
        onPressed: () => _showCreateRuleDialog(),
        child: const Icon(Icons.add),
        tooltip: 'Create New Rule',
      ),
    );
  }

  Widget _buildOverviewTab() {
    final automationState = ref.watch(automationStateProvider);
    final recentExecutions = ref.watch(recentExecutionsProvider);

    return SingleChildScrollView(
      padding: const EdgeInsets.all(16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // System Status Cards
          Row(
            children: [
              Expanded(
                child: _buildStatusCard(
                  title: 'Automation Engine',
                  status: automationState.engineStatus,
                  icon: Icons.memory,
                  color: automationState.engineStatus == EngineStatus.running
                      ? Colors.green
                      : Colors.orange,
                ),
              ),
              const SizedBox(width: 16),
              Expanded(
                child: _buildStatusCard(
                  title: 'Active Rules',
                  status: '${automationState.activeRulesCount}',
                  icon: Icons.rule,
                  color: Colors.blue,
                ),
              ),
            ],
          ),
          const SizedBox(height: 16),
          
          Row(
            children: [
              Expanded(
                child: _buildStatusCard(
                  title: 'Today\'s Executions',
                  status: '${automationState.todayExecutionsCount}',
                  icon: Icons.play_arrow,
                  color: Colors.purple,
                ),
              ),
              const SizedBox(width: 16),
              Expanded(
                child: _buildStatusCard(
                  title: 'Success Rate',
                  status: '${automationState.successRate.toStringAsFixed(1)}%',
                  icon: Icons.check_circle,
                  color: automationState.successRate > 90 ? Colors.green : Colors.orange,
                ),
              ),
            ],
          ),
          const SizedBox(height: 24),

          // Quick Actions
          _buildQuickActionsSection(),
          const SizedBox(height: 24),

          // Recent Activity
          _buildRecentActivitySection(recentExecutions),
          const SizedBox(height: 24),

          // Rule Performance Summary
          _buildRulePerformanceSection(),
        ],
      ),
    );
  }

  Widget _buildRulesTab() {
    final rules = ref.watch(automationRulesProvider);

    return Column(
      children: [
        // Rules Filter and Search
        Padding(
          padding: const EdgeInsets.all(16),
          child: Row(
            children: [
              Expanded(
                child: TextField(
                  decoration: const InputDecoration(
                    hintText: 'Search rules...',
                    prefixIcon: Icon(Icons.search),
                    border: OutlineInputBorder(),
                  ),
                  onChanged: (value) {
                    ref.read(rulesFilterProvider.notifier).setSearchQuery(value);
                  },
                ),
              ),
              const SizedBox(width: 16),
              FilterChip(
                label: const Text('Enabled'),
                selected: ref.watch(rulesFilterProvider).showEnabledOnly,
                onSelected: (selected) {
                  ref.read(rulesFilterProvider.notifier).setEnabledFilter(selected);
                },
              ),
              const SizedBox(width: 8),
              PopupMenuButton<RuleSortOption>(
                icon: const Icon(Icons.sort),
                onSelected: (option) {
                  ref.read(rulesFilterProvider.notifier).setSortOption(option);
                },
                itemBuilder: (context) => [
                  const PopupMenuItem(
                    value: RuleSortOption.name,
                    child: Text('Sort by Name'),
                  ),
                  const PopupMenuItem(
                    value: RuleSortOption.priority,
                    child: Text('Sort by Priority'),
                  ),
                  const PopupMenuItem(
                    value: RuleSortOption.lastExecution,
                    child: Text('Sort by Last Execution'),
                  ),
                  const PopupMenuItem(
                    value: RuleSortOption.successRate,
                    child: Text('Sort by Success Rate'),
                  ),
                ],
              ),
            ],
          ),
        ),

        // Rules List
        Expanded(
          child: rules.when(
            data: (rulesList) => rulesList.isEmpty
                ? _buildEmptyRulesState()
                : ListView.separated(
                    padding: const EdgeInsets.symmetric(horizontal: 16),
                    itemCount: rulesList.length,
                    separatorBuilder: (context, index) => const SizedBox(height: 8),
                    itemBuilder: (context, index) {
                      final rule = rulesList[index];
                      return AutomationRuleCard(
                        rule: rule,
                        onToggle: (enabled) => _toggleRule(rule.id, enabled),
                        onEdit: () => _editRule(rule),
                        onDelete: () => _deleteRule(rule),
                        onExecute: () => _executeRule(rule),
                      );
                    },
                  ),
            loading: () => const Center(child: CircularProgressIndicator()),
            error: (error, stack) => Center(
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  const Icon(Icons.error, size: 64, color: Colors.red),
                  const SizedBox(height: 16),
                  Text('Error loading rules: $error'),
                  const SizedBox(height: 16),
                  ElevatedButton(
                    onPressed: () => ref.refresh(automationRulesProvider),
                    child: const Text('Retry'),
                  ),
                ],
              ),
            ),
          ),
        ),
      ],
    );
  }

  Widget _buildHistoryTab() {
    final executionHistory = ref.watch(executionHistoryProvider);

    return Column(
      children: [
        // History Filters
        Padding(
          padding: const EdgeInsets.all(16),
          child: Row(
            children: [
              Expanded(
                child: DropdownButtonFormField<HistoryTimeRange>(
                  decoration: const InputDecoration(
                    labelText: 'Time Range',
                    border: OutlineInputBorder(),
                  ),
                  value: ref.watch(historyFilterProvider).timeRange,
                  items: HistoryTimeRange.values.map((range) {
                    return DropdownMenuItem(
                      value: range,
                      child: Text(range.displayName),
                    );
                  }).toList(),
                  onChanged: (range) {
                    if (range != null) {
                      ref.read(historyFilterProvider.notifier).setTimeRange(range);
                    }
                  },
                ),
              ),
              const SizedBox(width: 16),
              Expanded(
                child: DropdownButtonFormField<ExecutionStatus?>(
                  decoration: const InputDecoration(
                    labelText: 'Status',
                    border: OutlineInputBorder(),
                  ),
                  value: ref.watch(historyFilterProvider).status,
                  items: [
                    const DropdownMenuItem(
                      value: null,
                      child: Text('All Statuses'),
                    ),
                    ...ExecutionStatus.values.map((status) {
                      return DropdownMenuItem(
                        value: status,
                        child: Row(
                          children: [
                            Icon(
                              _getStatusIcon(status),
                              size: 16,
                              color: _getStatusColor(status),
                            ),
                            const SizedBox(width: 8),
                            Text(status.displayName),
                          ],
                        ),
                      );
                    }),
                  ],
                  onChanged: (status) {
                    ref.read(historyFilterProvider.notifier).setStatus(status);
                  },
                ),
              ),
            ],
          ),
        ),

        // Execution History List
        Expanded(
          child: executionHistory.when(
            data: (history) => history.isEmpty
                ? _buildEmptyHistoryState()
                : ListView.separated(
                    padding: const EdgeInsets.symmetric(horizontal: 16),
                    itemCount: history.length,
                    separatorBuilder: (context, index) => const Divider(),
                    itemBuilder: (context, index) {
                      final execution = history[index];
                      return ExecutionHistoryTile(
                        execution: execution,
                        onTap: () => _showExecutionDetails(execution),
                      );
                    },
                  ),
            loading: () => const Center(child: CircularProgressIndicator()),
            error: (error, stack) => Center(
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  const Icon(Icons.error, size: 64, color: Colors.red),
                  const SizedBox(height: 16),
                  Text('Error loading history: $error'),
                  const SizedBox(height: 16),
                  ElevatedButton(
                    onPressed: () => ref.refresh(executionHistoryProvider),
                    child: const Text('Retry'),
                  ),
                ],
              ),
            ),
          ),
        ),
      ],
    );
  }

  Widget _buildAnalyticsTab() {
    final analytics = ref.watch(automationAnalyticsProvider);

    return SingleChildScrollView(
      padding: const EdgeInsets.all(16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // Execution Trends Chart
          Card(
            child: Padding(
              padding: const EdgeInsets.all(16),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    'Execution Trends',
                    style: Theme.of(context).textTheme.titleLarge,
                  ),
                  const SizedBox(height: 16),
                  SizedBox(
                    height: 200,
                    child: analytics.when(
                      data: (data) => ExecutionTrendsChart(data: data.executionTrends),
                      loading: () => const Center(child: CircularProgressIndicator()),
                      error: (error, stack) => Center(child: Text('Error: $error')),
                    ),
                  ),
                ],
              ),
            ),
          ),
          const SizedBox(height: 16),

          // Success Rate by Rule
          Card(
            child: Padding(
              padding: const EdgeInsets.all(16),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    'Success Rate by Rule',
                    style: Theme.of(context).textTheme.titleLarge,
                  ),
                  const SizedBox(height: 16),
                  analytics.when(
                    data: (data) => Column(
                      children: data.ruleSuccessRates.map((ruleData) {
                        return Padding(
                          padding: const EdgeInsets.only(bottom: 8),
                          child: Row(
                            children: [
                              Expanded(
                                flex: 2,
                                child: Text(ruleData.ruleName),
                              ),
                              Expanded(
                                flex: 3,
                                child: LinearProgressIndicator(
                                  value: ruleData.successRate / 100,
                                  backgroundColor: Colors.grey[300],
                                  valueColor: AlwaysStoppedAnimation<Color>(
                                    ruleData.successRate > 90 
                                        ? Colors.green 
                                        : ruleData.successRate > 70 
                                            ? Colors.orange 
                                            : Colors.red,
                                  ),
                                ),
                              ),
                              Expanded(
                                child: Text(
                                  '${ruleData.successRate.toStringAsFixed(1)}%',
                                  textAlign: TextAlign.end,
                                ),
                              ),
                            ],
                          ),
                        );
                      }).toList(),
                    ),
                    loading: () => const Center(child: CircularProgressIndicator()),
                    error: (error, stack) => Center(child: Text('Error: $error')),
                  ),
                ],
              ),
            ),
          ),
          const SizedBox(height: 16),

          // Most Active Rules
          Card(
            child: Padding(
              padding: const EdgeInsets.all(16),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    'Most Active Rules (Last 7 Days)',
                    style: Theme.of(context).textTheme.titleLarge,
                  ),
                  const SizedBox(height: 16),
                  analytics.when(
                    data: (data) => Column(
                      children: data.mostActiveRules.map((ruleData) {
                        return ListTile(
                          leading: CircleAvatar(
                            child: Text('${ruleData.executionCount}'),
                          ),
                          title: Text(ruleData.ruleName),
                          subtitle: Text('${ruleData.executionCount} executions'),
                          trailing: Icon(
                            _getPriorityIcon(ruleData.priority),
                            color: _getPriorityColor(ruleData.priority),
                          ),
                        );
                      }).toList(),
                    ),
                    loading: () => const Center(child: CircularProgressIndicator()),
                    error: (error, stack) => Center(child: Text('Error: $error')),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildStatusCard({
    required String title,
    required String status,
    required IconData icon,
    required Color color,
  }) {
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Icon(icon, color: color),
                const SizedBox(width: 8),
                Text(
                  title,
                  style: Theme.of(context).textTheme.titleSmall,
                ),
              ],
            ),
            const SizedBox(height: 8),
            Text(
              status,
              style: Theme.of(context).textTheme.headlineMedium?.copyWith(
                color: color,
                fontWeight: FontWeight.bold,
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildQuickActionsSection() {
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              'Quick Actions',
              style: Theme.of(context).textTheme.titleMedium?.copyWith(
                fontWeight: FontWeight.bold,
              ),
            ),
            const SizedBox(height: 16),
            Row(
              children: [
                Expanded(
                  child: ElevatedButton.icon(
                    onPressed: () => _showCreateRuleDialog(),
                    icon: const Icon(Icons.add),
                    label: const Text('Create Rule'),
                  ),
                ),
                const SizedBox(width: 8),
                Expanded(
                  child: OutlinedButton.icon(
                    onPressed: () => _importRules(),
                    icon: const Icon(Icons.file_upload),
                    label: const Text('Import Rules'),
                  ),
                ),
                const SizedBox(width: 8),
                Expanded(
                  child: OutlinedButton.icon(
                    onPressed: () => _exportRules(),
                    icon: const Icon(Icons.file_download),
                    label: const Text('Export Rules'),
                  ),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildRecentActivitySection(AsyncValue<List<RuleExecution>> recentExecutions) {
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Text(
                  'Recent Activity',
                  style: Theme.of(context).textTheme.titleMedium?.copyWith(
                    fontWeight: FontWeight.bold,
                  ),
                ),
                TextButton(
                  onPressed: () => _tabController.animateTo(2),
                  child: const Text('View All'),
                ),
              ],
            ),
            const SizedBox(height: 16),
            recentExecutions.when(
              data: (executions) => Column(
                children: executions.take(5).map((execution) {
                  return ListTile(
                    leading: Icon(
                      _getStatusIcon(execution.status),
                      color: _getStatusColor(execution.status),
                    ),
                    title: Text(execution.ruleName),
                    subtitle: Text(_formatDateTime(execution.executedAt)),
                    trailing: execution.duration != null
                        ? Text('${execution.duration!.inMilliseconds}ms')
                        : null,
                  );
                }).toList(),
              ),
              loading: () => const Center(child: CircularProgressIndicator()),
              error: (error, stack) => Text('Error loading recent activity: $error'),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildRulePerformanceSection() {
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              'Rule Performance Summary',
              style: Theme.of(context).textTheme.titleMedium?.copyWith(
                fontWeight: FontWeight.bold,
              ),
            ),
            const SizedBox(height: 16),
            // This would show a summary of rule performance metrics
            // Implementation would depend on the analytics data structure
            const Text('Performance metrics would be displayed here'),
          ],
        ),
      ),
    );
  }

  Widget _buildEmptyRulesState() {
    return Center(
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Icon(
            Icons.rule_outlined,
            size: 64,
            color: Theme.of(context).colorScheme.outline,
          ),
          const SizedBox(height: 16),
          Text(
            'No automation rules yet',
            style: Theme.of(context).textTheme.headlineSmall,
          ),
          const SizedBox(height: 8),
          Text(
            'Create your first automation rule to get started',
            style: Theme.of(context).textTheme.bodyMedium?.copyWith(
              color: Theme.of(context).colorScheme.outline,
            ),
          ),
          const SizedBox(height: 24),
          ElevatedButton.icon(
            onPressed: () => _showCreateRuleDialog(),
            icon: const Icon(Icons.add),
            label: const Text('Create First Rule'),
          ),
        ],
      ),
    );
  }

  Widget _buildEmptyHistoryState() {
    return Center(
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Icon(
            Icons.history,
            size: 64,
            color: Theme.of(context).colorScheme.outline,
          ),
          const SizedBox(height: 16),
          Text(
            'No execution history',
            style: Theme.of(context).textTheme.headlineSmall,
          ),
          const SizedBox(height: 8),
          Text(
            'Rule executions will appear here',
            style: Theme.of(context).textTheme.bodyMedium?.copyWith(
              color: Theme.of(context).colorScheme.outline,
            ),
          ),
        ],
      ),
    );
  }

  IconData _getStatusIcon(ExecutionStatus status) {
    switch (status) {
      case ExecutionStatus.success:
        return Icons.check_circle;
      case ExecutionStatus.failed:
        return Icons.error;
      case ExecutionStatus.running:
        return Icons.play_circle;
      case ExecutionStatus.cancelled:
        return Icons.cancel;
    }
  }

  Color _getStatusColor(ExecutionStatus status) {
    switch (status) {
      case ExecutionStatus.success:
        return Colors.green;
      case ExecutionStatus.failed:
        return Colors.red;
      case ExecutionStatus.running:
        return Colors.blue;
      case ExecutionStatus.cancelled:
        return Colors.orange;
    }
  }

  IconData _getPriorityIcon(RulePriority priority) {
    switch (priority) {
      case RulePriority.low:
        return Icons.keyboard_arrow_down;
      case RulePriority.normal:
        return Icons.remove;
      case RulePriority.high:
        return Icons.keyboard_arrow_up;
      case RulePriority.critical:
        return Icons.priority_high;
    }
  }

  Color _getPriorityColor(RulePriority priority) {
    switch (priority) {
      case RulePriority.low:
        return Colors.blue;
      case RulePriority.normal:
        return Colors.grey;
      case RulePriority.high:
        return Colors.orange;
      case RulePriority.critical:
        return Colors.red;
    }
  }

  String _formatDateTime(DateTime dateTime) {
    final now = DateTime.now();
    final difference = now.difference(dateTime);

    if (difference.inMinutes < 1) {
      return 'Just now';
    } else if (difference.inHours < 1) {
      return '${difference.inMinutes}m ago';
    } else if (difference.inDays < 1) {
      return '${difference.inHours}h ago';
    } else {
      return '${difference.inDays}d ago';
    }
  }

  void _showCreateRuleDialog() {
    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (context) => AutomationRuleBuilder(
          onSaved: (rule) {
            ref.read(automationRulesProvider.notifier).addRule(rule);
          },
        ),
      ),
    );
  }

  void _editRule(AutomationRule rule) {
    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (context) => AutomationRuleBuilder(
          existingRule: rule,
          onSaved: (updatedRule) {
            ref.read(automationRulesProvider.notifier).updateRule(updatedRule);
          },
        ),
      ),
    );
  }

  void _deleteRule(AutomationRule rule) {
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Delete Rule'),
        content: Text('Are you sure you want to delete "${rule.name}"?'),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(context).pop(),
            child: const Text('Cancel'),
          ),
          TextButton(
            onPressed: () {
              Navigator.of(context).pop();
              ref.read(automationRulesProvider.notifier).deleteRule(rule.id);
            },
            child: const Text('Delete'),
          ),
        ],
      ),
    );
  }

  void _toggleRule(String ruleId, bool enabled) {
    ref.read(automationRulesProvider.notifier).toggleRule(ruleId, enabled);
  }

  void _executeRule(AutomationRule rule) {
    ref.read(automationRulesProvider.notifier).executeRule(rule.id);
    
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text('Executing rule "${rule.name}"...'),
        duration: const Duration(seconds: 2),
      ),
    );
  }

  void _showExecutionDetails(RuleExecution execution) {
    showDialog(
      context: context,
      builder: (context) => ExecutionDetailsDialog(execution: execution),
    );
  }

  void _refreshData() {
    ref.refresh(automationStateProvider);
    ref.refresh(automationRulesProvider);
    ref.refresh(executionHistoryProvider);
    ref.refresh(automationAnalyticsProvider);
  }

  void _importRules() {
    // Implementation for importing rules from file
    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text('Import functionality would be implemented here'),
      ),
    );
  }

  void _exportRules() {
    // Implementation for exporting rules to file
    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text('Export functionality would be implemented here'),
      ),
    );
  }
}

