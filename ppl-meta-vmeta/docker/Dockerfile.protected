FROM python:3.11.11-slim-bookworm AS builder

WORKDIR /app

ENV CC=gcc \
    CXX=g++ \
    CMAKE_GENERATOR="Unix Makefiles"

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    gcc \
    g++ \
    make \
    pkg-config \
    python3-dev \
    libgl1-mesa-dri \
    libglx-mesa0 \
    libglx0 \
    libglib2.0-0 \
    libgomp1 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libx11-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/ requirements/
# dlib-bin provides pre-built wheels (no source compilation needed).
# Prefer binary wheels and never require hashes: PyPI wheel digests for
# transitive deps can drift and break --require-hashes style installs.
ENV PIP_REQUIRE_HASHES=0 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir --prefer-binary -r requirements/base.txt

COPY src/ ./src/
COPY setup_protected.py ./setup_protected.py

# --inplace + package_dir src writes services/*.so under /app/src/services/.
RUN python setup_protected.py build_ext --inplace \
 && python setup_protected.py verify

FROM python:3.11.11-slim-bookworm AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libgl1 \
    libgl1-mesa-dri \
    libglx-mesa0 \
    libglx0 \
    libglib2.0-0 \
    libgomp1 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libx11-6 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local /usr/local

COPY --from=builder /app/src/ ./src/
COPY --from=builder /app/setup_protected.py ./setup_protected.py

# Do not delete the .py sources unless matching .so files are present.
RUN python setup_protected.py verify \
 && find /app/src -name "*.pyc" -delete \
 && find /app/src -name "*.c" -delete \
 && rm -f /app/src/services/embedding_service.py \
          /app/src/services/workflow_service.py \
          /app/src/services/mvr_service.py \
          /app/src/services/hierarchical_mvr_merger.py \
          /app/src/services/quality_selector.py \
 && PYTHONPATH=/app/src python -c "import jwt; from services.embedding_service import EmbeddingService; from services.workflow_service import WorkflowService; from services.mvr_service import MVRService" \
 && rm -f /app/setup_protected.py

EXPOSE 8008

CMD ["python", "src/main.py"]
