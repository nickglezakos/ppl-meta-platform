# Phase 1 Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ppl_meta
DB_USER=ppl_user
DB_PASSWORD=ppl_password

# Phase 1 API Configuration
API_HOST=0.0.0.0
API_PORT=8010

# Phase 1 Vision Configuration
DISTANCE_MULTIPLIER=1000000.0
EMBEDDING_MODEL=Facenet512
DETECTOR_BACKEND=opencv
CONFIDENCE_THRESHOLD=0.5
FRAMES_PER_SECOND=3

# Phase 1 Features
ENABLE_DISTANCE_CALCULATION=true
ENABLE_EMBEDDING_GENERATION=true
ENABLE_ROUTE_TRACKING=true

# ============================================================
# Batch Processing Configuration
# ============================================================

# Batch Processing Feature Flag
ENABLE_BATCH_PROCESSING=true

# Configuration File Path
BATCH_PROCESSING_CONFIG_PATH=config/batch_processing.yml

# Batch Size Configuration
BATCH_SIZE_THRESHOLD=5
PARTIAL_BATCH_MIN_VIDEOS=2
PARTIAL_BATCH_TIMEOUT_MINUTES=10
PARTIAL_BATCH_MAX_WAIT_HOURS=24

# Event Triggering
ENABLE_RECORDING_STOP_EVENT=true
RECORDING_STOP_TRIGGER_DELAY_SECONDS=2
ENABLE_TIMEOUT_FALLBACK=true

# Concurrency Settings
MAX_CONCURRENT_BATCHES=3
WORKER_POOL_SIZE=3

# Resource Limits
MAX_BATCH_MEMORY_GB=2
MAX_VIDEOS_PER_SESSION=10
MAX_PROCESSING_TIME_SECONDS=300

# Event Configuration
ENABLE_EVENT_TRIGGERING=true
ENABLE_POLLING_FALLBACK=true
POLLING_INTERVAL_SECONDS=30

# Caching Configuration
ENABLE_BATCH_CACHING=true
INDIVIDUAL_CACHE_TTL=3600
MVR_CACHE_TTL=7200
CACHE_BACKEND=redis

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=10

# Processing Pipeline Configuration
INDIVIDUAL_CONFIDENCE_THRESHOLD=0.7
MIN_FACES_PER_MVR_PERSON=3
MVR_GROUPING_CONFIDENCE=0.8
ENABLE_INCREMENTAL_MVR=true

# Monitoring and Logging
BATCH_METRICS_ENABLED=true
BATCH_LOG_LEVEL=INFO
BATCH_PROFILING_ENABLED=false
METRICS_EXPORT_INTERVAL=60

# Alert Thresholds
SLOW_BATCH_THRESHOLD_SECONDS=600
LOW_CACHE_HIT_RATE_PERCENT=30
CONSECUTIVE_FAILURE_ALERT_COUNT=3

# Error Handling and Retries
MAX_BATCH_RETRIES=3
RETRY_STRATEGY=exponential_backoff
INITIAL_RETRY_DELAY_SECONDS=5
MAX_RETRY_DELAY_SECONDS=300
ENABLE_DEAD_LETTER_QUEUE=true
DEAD_LETTER_QUEUE_MAX_SIZE=100

# Development/Testing
USE_MOCK_BATCH_DATA=false
BATCH_DEBUG_MODE=false
SIMULATE_SLOW_PROCESSING=false
SLOW_PROCESSING_DELAY_SECONDS=5
