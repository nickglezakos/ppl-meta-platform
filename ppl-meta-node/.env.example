# PPL Meta Node - User Management Service Environment Configuration
# WARNING: This file contains example values only. Do NOT commit actual secrets to version control!

# Application Settings
APP_NAME=PPL Meta Node - User Management Service
APP_VERSION=1.0.1
DEBUG=false
LOG_LEVEL=info
LOG_FORMAT=console
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development

# Database Configuration
# Use secrets management for production: /run/secrets/database_password
DATABASE_URL=postgresql://nickadmin:${DATABASE_PASSWORD}@localhost:5433/ppl_db

# Security Settings - CHANGE THESE VALUES FOR PRODUCTION
# In production, these should be read from Docker secrets or external key management
SECRET_KEY=${SECRET_KEY}
JWT_SECRET=${JWT_SECRET}
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_PASSWORD_SECRET=${RESET_PASSWORD_SECRET}

# Standardized Mail Configuration
# In production, use: /run/secrets/mail_password
MAIL_USERNAME=${MAIL_USERNAME}
MAIL_PASSWORD=${MAIL_PASSWORD}
MAIL_FROM=${MAIL_FROM}
MAIL_SERVER=${MAIL_SERVER}
MAIL_PORT=587
MAIL_FROM_NAME=PPL Meta Node
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
USE_CREDENTIALS=true
VALIDATE_CERTS=true

# SMTP Settings (Alternative naming - for compatibility)
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=587
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}

# Service Communication URLs
PPL_MEDIA_SERVICE_URL=http://localhost:8000
MEDIA_SERVICE_URL=http://localhost:8000
GATEWAY_SERVICE_URL=http://localhost:8080
SERVICE_SECRET=${SERVICE_SECRET}

# Redis Configuration
# In production, use: /run/secrets/redis_password
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=${REDIS_PASSWORD}

# External Key Management
VAULT_TOKEN=${VAULT_TOKEN}
VAULT_URL=${VAULT_URL}

# Security Notes:
# 1. Replace ${VARIABLE} placeholders with actual values for development
# 2. Use secrets management (Docker secrets, Vault, etc.) for production
# 3. Never commit actual secrets to version control
# 4. Rotate secrets regularly using automated tools
# 5. Use strong, unique secrets for each environment

# Authority Service
AUTHORITY_SERVICE_ENABLED=true
AUTHORITY_SERVICE_URL=https://authority.eyenet-vision.com
AUTHORITY_INSTALLATION_UUID=tenant-a
AUTHORITY_APPLICATION_KEY=lic_6f3c8d1e2b4a5c7d8e9f0a1b2c3d4e5f
AUTHORITY_TIMEOUT_SECONDS=10
