    "select_close_and_group3": {
      "lines": [
        "    def select_close_and_group3(self, logger, next_frame_proximity, conn):",
        "        if self.conn is None:",
        "            self.conn = sqlite3.connect(self.db_file)",
        "        cursor = conn.cursor()",
        "        ",
        "        with self.conn as conn:",
        "            # Create an instance of the Settings class",
        "            settings_instance = settings.Settings()",
        "            focus_proximity = settings_instance.focus_proximity",
        "            reverse_depth_frames_ratio = settings_instance.reverse_depth_rects_ratio_close_frames",
        "            number_rects_devision_to_get_total_close_rects = settings_instance.number_rects_devision_to_get_total_close_rects",
        "            minimum_items_per_group = settings_instance.minimum_items_per_group",
        "            pd.set_option('display.max_columns', None)",
        "",
        "            # Query the database to get the data from the FaceRects, RawDetectionData, and FacePics tables",
        "            query = f\"\"\"",
        "                        SELECT FaceRects.*, RawDetectionData.frame_path, FacePics.face_pic",
        "                        FROM FaceRects",
        "                        JOIN RawDetectionData ON FaceRects.RawDetectionDataId = RawDetectionData.Id",
        "                        JOIN FacePics ON FaceRects.RawDetectionDataId = FacePics.RawDetectionDataId",
        "                        WHERE FaceRects.rect_width > {focus_proximity}",
        "                    \"\"\"",
        "            df = pd.read_sql_query(query, conn)",
        "",
        "            # Print the total number of rectangles before they are loaded into the DataFrame",
        "            print(\"Select Close and Group3\")",
        "            print(f\"Total number of face rectangles before loading into DataFrame: {len(df)}\")",
        "",
        "            # Extract the frame number from the frame_path and add it to the DataFrame",
        "            df['frame_number'] = df['frame_path'].str.extract(r'frame_(\\d+)\\.jpg').astype(int)",
        "",
        "            # Sort the DataFrame by the frame number",
        "            df = df.sort_values('frame_number')",
        "",
        "            num_frames = max(1, round(len(df) / reverse_depth_frames_ratio))",
        "            if num_frames < settings_instance.num_frames:",
        "                num_frames = settings_instance.num_frames",
        "            print(f\"Number of face frames after the current frame to compare: {num_frames}\")",
        "",
