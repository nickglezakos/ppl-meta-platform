        "    def is_close(self, rect1, rect2, next_frame_proximity):",
        "        settings_instance = settings.Settings()",
        "        mode = settings_instance.is_close_mode",
        "",
        "        # Only consider the first four elements of rect1 and rect2",
        "        rect1 = rect1[:4]",
        "        rect2 = rect2[:4]",
        "",
        "        # rect1 and rect2 have at least 4 elements",
        "        assert len(rect1) >= 4, f\"rect1 tuple has less than 4 elements: {rect1}\"",
        "        assert len(rect2) >= 4, f\"rect2 tuple has less than 4 elements: {rect2}\"",
        "",
        "        # Calculate the areas of rect1 and rect2",
        "        area1 = rect1[2] * rect1[3]",
        "        area2 = rect2[2] * rect2[3]",
        "",
        "        # Check if the area of rect1 is bigger or smaller by more than 15% than the area of rect2",
        "        if not (0.85 * area2 <= area1 <= 1.15 * area2):",
        "            return False, None, None",
        "",
        "        # center1 and center2",
        "        center1 = (rect1[0] + rect1[2] / 2, rect1[1] + rect1[3] / 2)",
        "        center2 = (rect2[0] + rect2[2] / 2, rect2[1] + rect2[3] / 2)",
        "",
        "        if mode == 1:",
        "            # Compare only the X coordinates",
        "            distance = abs(center1[0] - center2[0])",
        "        elif mode == 2:",
        "            # Compare only the Y coordinates",
        "            distance = abs(center1[1] - center2[1])",
        "        else:",
        "            # Calculate the Euclidean distance between the centers",
        "            distance = ((center1[0] - center2[0]) ** 2 + (center1[1] - center2[1]) ** 2) ** 0.5",
        "",
        "        # If the distance is less than the next_frame_proximity, return True",
        "        if distance < next_frame_proximity:",
        "            return True, None, distance",
        "",
        "        # If no pair of rectangles is close, return False and None for both indices",
        "        return False, None, distance",
        "    ",
        "    ",
        ""
