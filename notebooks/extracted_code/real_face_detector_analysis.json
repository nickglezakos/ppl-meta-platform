    "__exit__": {
      "lines": [
        "    def __exit__(self, exc_type, exc_val, exc_tb):",
        "        if self.conn:",
        "            if exc_type is None:  # No exceptions were raised within the block",
        "                self.conn.commit()",
        "                self.logger.info(\"Changes committed to the database.\")",
        "            else:",
        "                self.conn.rollback()  # Rollback in case of exception",
        "                self.logger.error(f\"Database transaction rolled back due to an exception from FaceDetector: {exc_val}\")",
        "            if self.c:",
        "                self.c.close()",
        "            if self.internal_conn:  # Only close if we opened the connection",
        "                self.conn.close()",
        "                self.logger.info(\"Database connection closed.\")",
        "",
        ""
      ],
