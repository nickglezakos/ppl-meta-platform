        "    def __enter__(self):",
        "        if self.conn is None:",
        "            self.conn = sqlite3.connect(self.db_file)",
        "            self.c = self.conn.cursor()",
        "            self.logger.info(f\"Connected to database at {self.db_file} from FaceDetector\")",
        "            self.internal_conn = True  # Mark that the connection was created internally",
        "        return self",
