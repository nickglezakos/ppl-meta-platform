{
    "folders": [
        {
            "name": "PPL Meta Platform",
            "path": "."
        }
    ],
    "settings": {
        "python.defaultInterpreterPath": "./venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "python.linting.flake8Enabled": true,
        "python.formatting.provider": "black",
        "python.sortImports.args": ["--profile", "black"],
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        },
        "files.exclude": {
            "**/__pycache__": true,
            "**/*.pyc": true,
            "**/venv": true,
            "**/node_modules": true,
            "**/.git": true,
            "**/.DS_Store": true,
            "**/logs": true,
            "**/*.log": true
        },
        "search.exclude": {
            "**/venv": true,
            "**/node_modules": true,
            "**/*.log": true,
            "**/logs": true
        },
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.nosetestsEnabled": false,
        "docker.defaultRegistryPath": "nickglezakos",
        "git.enableSmartCommit": true,
        "git.confirmSync": false,
        "terminal.integrated.env.osx": {
            "PYTHONPATH": "${workspaceFolder}"
        },
        "terminal.integrated.env.linux": {
            "PYTHONPATH": "${workspaceFolder}"
        },
        "terminal.integrated.env.windows": {
            "PYTHONPATH": "${workspaceFolder}"
        }
    },
    "extensions": {
        "recommendations": [
            "ms-python.python",
            "ms-python.vscode-pylance", 
            "ms-python.black-formatter",
            "ms-python.isort",
            "ms-python.flake8",
            "ms-vscode.vscode-docker",
            "redhat.vscode-yaml",
            "ms-vscode.vscode-json",
            "github.copilot",
            "github.copilot-chat",
            "ms-vsliveshare.vsliveshare",
            "eamodio.gitlens",
            "ms-vscode.test-adapter-converter",
            "littlefoxteam.vscode-python-test-adapter"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Setup Development Environment",
                "type": "shell",
                "command": "./setup-dev.sh",
                "group": "build",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                },
                "problemMatcher": []
            },
            {
                "label": "🏗️ Build All Docker Images",
                "type": "shell",
                "command": "docker-compose",
                "args": ["-f", "docker-compose.minimal.yml", "build"],
                "group": "build",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                },
                "problemMatcher": []
            },
            {
                "label": "🏗️ Build Gateway Image",
                "type": "shell",
                "command": "docker",
                "args": ["build", "-t", "ppl-meta-gateway", "."],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-gateway"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "🏗️ Build Node Image",
                "type": "shell",
                "command": "docker",
                "args": ["build", "-t", "ppl-meta-node", "."],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-node"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "🏗️ Build Media Image",
                "type": "shell",
                "command": "docker",
                "args": ["build", "-t", "ppl-meta-media", "."],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-media"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "🏗️ Build Orchestrator Image",
                "type": "shell",
                "command": "docker",
                "args": ["build", "-t", "ppl-meta-orchestrator", "."],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-orchestrator"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "🚀 Start All Services",
                "type": "shell",
                "command": "docker-compose",
                "args": ["-f", "docker-compose.minimal.yml", "up", "-d"],
                "group": "build",
                "presentation": {
                    "reveal": "always"
                },
                "dependsOn": ["🏗️ Build All Docker Images"]
            },
            {
                "label": "🛑 Stop All Services",
                "type": "shell",
                "command": "docker-compose",
                "args": ["-f", "docker-compose.minimal.yml", "down"],
                "group": "build",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "🔄 Restart All Services",
                "type": "shell",
                "command": "docker-compose",
                "args": ["-f", "docker-compose.minimal.yml", "restart"],
                "group": "build",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "Start Infrastructure",
                "type": "shell", 
                "command": "docker-compose",
                "args": ["-f", "docker-compose.ecosystem.yml", "up", "-d"],
                "group": "build",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "Stop Infrastructure",
                "type": "shell",
                "command": "docker-compose", 
                "args": ["-f", "docker-compose.ecosystem.yml", "down"],
                "group": "build"
            },
            {
                "label": "🏥 Health Check - All Services",
                "type": "shell",
                "command": "python",
                "args": ["-c", "import requests; import sys; services = [('Gateway', 'http://localhost:8080/health'), ('Node', 'http://localhost:8001/health'), ('Media', 'http://localhost:8000/health'), ('Orchestrator', 'http://localhost:8002/health')]; results = []; [results.append(f'✅ {name}: {requests.get(url, timeout=5).status_code}' if (lambda: requests.get(url, timeout=5).status_code == 200)() else f'❌ {name}: Failed') for name, url in services]; [print(r) for r in results]"],
                "group": "test",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "🏥 Health Check - Gateway",
                "type": "shell",
                "command": "curl",
                "args": ["-s", "http://localhost:8080/health"],
                "group": "test",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "🏥 Health Check - Node Service",
                "type": "shell",
                "command": "curl",
                "args": ["-s", "http://localhost:8001/health"],
                "group": "test",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "🏥 Health Check - Media Service",
                "type": "shell",
                "command": "curl",
                "args": ["-s", "http://localhost:8000/health"],
                "group": "test",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "🏥 Health Check - Orchestrator",
                "type": "shell",
                "command": "curl",
                "args": ["-s", "http://localhost:8002/health"],
                "group": "test",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "📊 Docker Status",
                "type": "shell",
                "command": "docker-compose",
                "args": ["-f", "docker-compose.minimal.yml", "ps"],
                "group": "test",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "📈 Service Metrics - All",
                "type": "shell",
                "command": "python",
                "args": ["test_metrics_implementation.py"],
                "group": "test",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "📋 View Logs - All Services",
                "type": "shell",
                "command": "docker-compose",
                "args": ["-f", "docker-compose.minimal.yml", "logs", "-f"],
                "group": "test",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "📋 View Logs - Gateway",
                "type": "shell",
                "command": "docker-compose",
                "args": ["-f", "docker-compose.minimal.yml", "logs", "-f", "ppl-meta-gateway"],
                "group": "test",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "📋 View Logs - Node Service",
                "type": "shell",
                "command": "docker-compose",
                "args": ["-f", "docker-compose.minimal.yml", "logs", "-f", "ppl-meta-node"],
                "group": "test",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "📋 View Logs - Media Service",
                "type": "shell",
                "command": "docker-compose",
                "args": ["-f", "docker-compose.minimal.yml", "logs", "-f", "ppl-meta-media"],
                "group": "test",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "📋 View Logs - Database",
                "type": "shell",
                "command": "docker-compose",
                "args": ["-f", "docker-compose.minimal.yml", "logs", "-f", "postgres"],
                "group": "test",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "Start User Management Service",
                "type": "shell",
                "command": "python",
                "args": ["src/main.py"],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-node"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "Start Media Service", 
                "type": "shell",
                "command": "python",
                "args": ["src/main.py"],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-media"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "Start Gateway Service",
                "type": "shell", 
                "command": "python",
                "args": ["src/main.py"],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-gateway"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always", 
                    "panel": "new"
                }
            },
            {
                "label": "Start Orchestrator Service",
                "type": "shell",
                "command": "python",
                "args": ["src/main.py"],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-orchestrator"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "🧪 Run Tests - All Services",
                "type": "shell",
                "command": "python",
                "args": ["-m", "pytest", "tests/", "-v"],
                "group": "test",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "🧹 Clean Docker Resources",
                "type": "shell",
                "command": "docker",
                "args": ["system", "prune", "-f"],
                "group": "build",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "📦 Show Docker Images",
                "type": "shell",
                "command": "docker",
                "args": ["images", "--filter", "reference=ppl-meta-*"],
                "group": "test",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "🔍 Service Discovery Status",
                "type": "shell",
                "command": "docker",
                "args": ["exec", "ppl-consul", "consul", "members"],
                "group": "test",
                "presentation": {
                    "reveal": "always"
                }
            }
        ]
    }
}
