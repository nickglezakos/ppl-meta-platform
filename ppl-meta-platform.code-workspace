{
    "folders": [
        {
            "name": "PPL Meta Platform",
            "path": "."
        }
    ],
    "settings": {
        "python.defaultInterpreterPath": "./venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "python.linting.flake8Enabled": true,
        "python.formatting.provider": "black",
        "python.sortImports.args": ["--profile", "black"],
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        },
        "files.exclude": {
            "**/__pycache__": true,
            "**/*.pyc": true,
            "**/venv": true,
            "**/node_modules": true,
            "**/.git": true,
            "**/.DS_Store": true,
            "**/logs": true,
            "**/*.log": true
        },
        "search.exclude": {
            "**/venv": true,
            "**/node_modules": true,
            "**/*.log": true,
            "**/logs": true
        },
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.nosetestsEnabled": false,
        "docker.defaultRegistryPath": "nickglezakos",
        "git.enableSmartCommit": true,
        "git.confirmSync": false,
        "terminal.integrated.env.osx": {
            "PYTHONPATH": "${workspaceFolder}"
        },
        "terminal.integrated.env.linux": {
            "PYTHONPATH": "${workspaceFolder}"
        },
        "terminal.integrated.env.windows": {
            "PYTHONPATH": "${workspaceFolder}"
        },
        "dart.flutterSdkPath": "/usr/local/bin/flutter",
        "dart.lineLength": 100,
        "dart.closingLabels": true,
        "dart.openDevTools": "flutter",
        "flutter.sdk": "/usr/local/bin/flutter"
    },
        "extensions": {
        "recommendations": [
            "ms-python.python",
            "ms-python.vscode-pylance", 
            "ms-python.black-formatter",
            "ms-python.isort",
            "ms-python.flake8",
            "ms-vscode.vscode-docker",
            "redhat.vscode-yaml",
            "ms-vscode.vscode-json",
            "github.copilot",
            "github.copilot-chat",
            "ms-vsliveshare.vsliveshare",
            "eamodio.gitlens",
            "ms-vscode.test-adapter-converter",
            "littlefoxteam.vscode-python-test-adapter",
            "dart-code.dart-code",
            "dart-code.flutter",
            "bradlc.vscode-tailwindcss",
            "ms-vscode.vscode-typescript-next",
            "ms-ceintl.vscode-language-pack-de"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Setup Development Environment",
                "type": "shell",
                "command": "./setup-dev.sh",
                "group": "build",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                },
                "problemMatcher": []
            },
            {
                "label": "Start Infrastructure",
                "type": "shell", 
                "command": "docker-compose",
                "args": ["-f", "docker-compose.ecosystem.yml", "up", "-d"],
                "group": "build",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "Stop Infrastructure",
                "type": "shell",
                "command": "docker-compose", 
                "args": ["-f", "docker-compose.ecosystem.yml", "down"],
                "group": "build"
            },
            {
                "label": "🚀 Start User Management Service",
                "type": "shell",
                "command": "python",
                "args": ["src/main.py"],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-node"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "🚀 Start Media Service", 
                "type": "shell",
                "command": "python",
                "args": ["src/main.py"],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-media"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "🚀 Start Gateway Service",
                "type": "shell", 
                "command": "python",
                "args": ["src/main.py"],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-gateway"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always", 
                    "panel": "new"
                }
            },
            {
                "label": "🚀 Start Orchestrator Service",
                "type": "shell",
                "command": "python",
                "args": ["src/main.py"],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-orchestrator"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "🚀 Start Camera Service",
                "type": "shell",
                "command": "python",
                "args": ["src/main.py"],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-cameras"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "🚀 Start Vision Service",
                "type": "shell",
                "command": "python",
                "args": ["src/main.py"],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-vision"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "🚀 Start Discovery Service",
                "type": "shell",
                "command": "python",
                "args": ["src/main.py"],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-discovery"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "📱 Start Flutter Frontend",
                "type": "shell",
                "command": "flutter",
                "args": ["run"],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-frontend"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "🏥 Health Check All Services",
                "type": "shell",
                "command": "bash",
                "args": ["-c", "echo '🏥 Checking service health...' && for port in 8000 8001 8002 8003 8004 8005; do echo \"Port $port:\" && (curl -s http://localhost:$port/health 2>/dev/null | head -1 || echo 'Not responding'); done"],
                "group": "test",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "🚀 Start All Local Python Services",
                "type": "shell",
                "command": "./manage-services.sh",
                "args": ["start"],
                "group": "build",
                "isBackground": true,
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                },
                "problemMatcher": []
            },
            {
                "label": "🛑 Stop All Local Python Services",
                "type": "shell",
                "command": "./manage-services.sh",
                "args": ["stop"],
                "group": "build",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "🔄 Restart All Local Python Services",
                "type": "shell",
                "command": "./manage-services.sh",
                "args": ["restart"],
                "group": "build",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "📊 Check All Services Status",
                "type": "shell",
                "command": "./manage-services.sh",
                "args": ["status"],
                "group": "test",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "🌐 Start Nginx",
                "type": "shell",
                "command": "./manage-services.sh",
                "args": ["nginx-start"],
                "group": "build",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "🛑 Stop Nginx",
                "type": "shell",
                "command": "./manage-services.sh",
                "args": ["nginx-stop"],
                "group": "build",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "🐘 Start PostgreSQL Database",
                "type": "shell",
                "command": "brew",
                "args": ["services", "start", "postgresql"],
                "group": "build",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "🛑 Stop PostgreSQL Database",
                "type": "shell",
                "command": "brew",
                "args": ["services", "stop", "postgresql"],
                "group": "build",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "🔧 Setup PostgreSQL for PPL Meta",
                "type": "shell",
                "command": "bash",
                "args": ["-c", "echo '🔧 Setting up PostgreSQL for PPL Meta Platform...' && createuser -s postgres 2>/dev/null || echo 'User postgres already exists' && createdb ppl_meta_users 2>/dev/null || echo 'Database ppl_meta_users already exists' && echo '✅ PostgreSQL setup complete!'"],
                "group": "build",
                "presentation": {
                    "reveal": "always"
                }
            }
        ]
    }
}
