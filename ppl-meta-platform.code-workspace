{
    "folders": [
        {
            "name": "PPL Meta Platform",
            "path": "."
        },
        {
            "name": "User Management",
            "path": "./ppl-meta-node"
        },
        {
            "name": "Media Service", 
            "path": "./ppl-meta-media"
        },
        {
            "name": "Gateway Service",
            "path": "./ppl-meta-gateway"
        },
        {
            "name": "Orchestrator",
            "path": "./ppl-meta-orchestrator"
        },
        {
            "name": "Service Template",
            "path": "./service-template"
        },
        {
            "name": "Shared Code",
            "path": "./ppl-meta-code"
        }
    ],
    "settings": {
        "python.defaultInterpreterPath": "./venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "python.linting.flake8Enabled": true,
        "python.formatting.provider": "black",
        "python.sortImports.args": ["--profile", "black"],
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        },
        "files.exclude": {
            "**/__pycache__": true,
            "**/*.pyc": true,
            "**/venv": true,
            "**/node_modules": true,
            "**/.git": true,
            "**/.DS_Store": true,
            "**/logs": true,
            "**/*.log": true
        },
        "search.exclude": {
            "**/venv": true,
            "**/node_modules": true,
            "**/*.log": true,
            "**/logs": true
        },
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.nosetestsEnabled": false,
        "docker.defaultRegistryPath": "nickglezakos",
        "git.enableSmartCommit": true,
        "git.confirmSync": false,
        "terminal.integrated.env.osx": {
            "PYTHONPATH": "${workspaceFolder}"
        },
        "terminal.integrated.env.linux": {
            "PYTHONPATH": "${workspaceFolder}"
        },
        "terminal.integrated.env.windows": {
            "PYTHONPATH": "${workspaceFolder}"
        }
    },
    "extensions": {
        "recommendations": [
            "ms-python.python",
            "ms-python.vscode-pylance", 
            "ms-python.black-formatter",
            "ms-python.isort",
            "ms-python.flake8",
            "ms-vscode.vscode-docker",
            "redhat.vscode-yaml",
            "ms-vscode.vscode-json",
            "github.copilot",
            "github.copilot-chat",
            "ms-vsliveshare.vsliveshare",
            "eamodio.gitlens",
            "ms-vscode.test-adapter-converter",
            "littlefoxteam.vscode-python-test-adapter"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Setup Development Environment",
                "type": "shell",
                "command": "./setup-dev.sh",
                "group": "build",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                },
                "problemMatcher": []
            },
            {
                "label": "Start Infrastructure",
                "type": "shell", 
                "command": "docker-compose",
                "args": ["-f", "docker-compose.ecosystem.yml", "up", "-d"],
                "group": "build",
                "presentation": {
                    "reveal": "always"
                }
            },
            {
                "label": "Stop Infrastructure",
                "type": "shell",
                "command": "docker-compose", 
                "args": ["-f", "docker-compose.ecosystem.yml", "down"],
                "group": "build"
            },
            {
                "label": "Start User Management Service",
                "type": "shell",
                "command": "python",
                "args": ["src/main.py"],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-node"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "Start Media Service", 
                "type": "shell",
                "command": "python",
                "args": ["src/main.py"],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-media"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            },
            {
                "label": "Start Gateway Service",
                "type": "shell", 
                "command": "python",
                "args": ["src/main.py"],
                "options": {
                    "cwd": "${workspaceFolder}/ppl-meta-gateway"
                },
                "group": "build",
                "presentation": {
                    "reveal": "always", 
                    "panel": "new"
                }
            }
        ]
    }
}
